[Unit]
Description=Kernel 1-Wire MQTT driver for WB-HomA
Wants=wb-hwconf-manager.service wb-modules.service
After=network.target wb-hwconf-manager.service wb-modules.service mosquitto.service

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=root
ExecStart=/usr/bin/wb-mqtt-w1
RestartPreventExitStatus=2 6
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target
Alias=wb-homa-w1.service